{
  "name": "dsh-win-native",
  "version": "0.1.4",
  "description": "DSH plugin: Windows correctness layer — GBK/GB18030/UTF-16/Big5/Shift-JIS encoding detection with confidence and lossy reporting, Windows path legality (reserved device names, 8.3, UNC, MAX_PATH), netstat interpretation and bounded read-only disk inspection.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run build && npm run check"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "plugin",
    "deterministic",
    "offline",
    "local-first",
    "no-network",
    "read-only",
    "windows",
    "win32",
    "powershell",
    "encoding",
    "gbk",
    "gb18030",
    "big5",
    "shift-jis",
    "codepage",
    "iconv",
    "mojibake",
    "utf-8",
    "utf-16",
    "path",
    "max-path",
    "unc",
    "reserved-names",
    "netstat",
    "port",
    "tcp",
    "disk-usage",
    "duplicates",
    "filesystem"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ax2/dsh-win-native.git"
  },
  "homepage": "https://zicode.com/software/",
  "bugs": {
    "url": "https://github.com/ax2/dsh-win-native/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "24",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "iconv-lite": "0.6.3"
  }
}
